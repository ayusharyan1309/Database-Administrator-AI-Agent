# Firebase web app config — Project settings → Your apps → Web app.
# These are public by design (they identify the project, they do not grant
# access; Firestore security rules and the backend enforce that). Safe to ship
# in the bundle and to commit.
#
# Leave these unset and the app runs with no sign-in at all, exactly as it did
# before authentication existed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
