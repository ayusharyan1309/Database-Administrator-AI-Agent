# OptiQuery Environment Variables
# Copy this file to .env and fill in the values

# AI Provider: "openai" or "anthropic"
OPTIQ_AI_PROVIDER=openai

# OpenAI (if using openai provider)
OPENAI_API_KEY=sk-your-key-here

# Anthropic (if using anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Target PostgreSQL database (the one being monitored)
OPTIQ_DB_URL=jdbc:postgresql://localhost:5432/optiq_target
OPTIQ_DB_USERNAME=optiq_monitor
OPTIQ_DB_PASSWORD=changeme

# Polling configuration
OPTIQ_POLL_INTERVAL_MS=300000
OPTIQ_SLOW_THRESHOLD_MS=500

# Slack notifications (optional)
OPTIQ_SLACK_ENABLED=false
OPTIQ_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
